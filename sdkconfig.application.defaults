# Keep the OTA writer only in the retained factory Recovery image. The normal
# application exposes the enter-Recovery RPC through iris_ota_support_start().
# CONFIG_ESP_IRIS_OTA is not set
CONFIG_ESP_IRIS_USB_PRODUCT="ESP-Iris Mosaico learning_assistant"
CONFIG_ESP_IRIS_HEALTH_TIMEOUT_MS=45000
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# TLS servers may send a full-size record (e.g. their certificate chain).
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=12
CONFIG_ESP_WIFI_RX_BA_WIN=6

# 发音缓存：SPI NAND 分层块设备 API（spi_nand_flash_init_with_layers）。
CONFIG_NAND_FLASH_ENABLE_BDL=y

# 发音缓存（/nand LittleFS）：BDL 报 block/read/prog=2048，cache<2048 直接
# ESP_ERR_INVALID_ARG（known-issues #16 坑 D）；对齐出厂 Recovery 的 4096。
# LittleFS 工作缓冲放 PSRAM（省内部 RAM ~40KB），仅 array_cache 留内部。
CONFIG_LITTLEFS_MALLOC_STRATEGY_SPIRAM=y
CONFIG_LITTLEFS_CACHE_SIZE=4096
CONFIG_LITTLEFS_USE_MTIME=y
CONFIG_LITTLEFS_OBJ_NAME_LEN=255

# 发音走有道 MP3：注册 MP3 解码器（esp_audio_dec_register_default 按此开关注册）。
CONFIG_AUDIO_DECODER_MP3_SUPPORT=y
